# ─── 1. AI Assistant & Concierge Providers ──────────────────────────────────
# The Concierge supports OpenAI (gpt-5.6-luna, gpt-4o-mini) and Anthropic (Claude 3.5 Sonnet).
# Add at least one key below. If omitted, built-in intelligent fallback runs.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_CHAT_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── 2. Transactional & Lead Notification Emails (Resend) ───────────────────
# Get your free API key at https://resend.com
# For development/testing without custom domain verification, use: onboarding@resend.dev
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Israel Dare <onboarding@resend.dev>

# ─── 3. Webhooks & Lead Pipeline Integration (n8n / CRM) ─────────────────────
# Used for dispatching newsletter subscriptions and concierge lead notifications
NEXT_PUBLIC_NEWSLETTER_WEBHOOK=https://n8n-digitalmavericks-u48043.vm.elestio.app/webhook/d4aa2064-907b-443b-a094-d2f6277e8cde

# ─── 4. Site URL & Metadata Base ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://israeldare.com

# ─── 5. Whop Checkout URLs (Digital Products & Masterclasses) ────────────────
